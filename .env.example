# 複製為 .env 後可覆寫預設值（直接執行也可，全部都有預設）

# 後端服務埠
PORT=3000

# 目標 FHIR 伺服器（預設為 HAPI 公開測試伺服器）
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# 租戶標記：HAPI 為公眾共用伺服器，所有資源都會貼上此 meta.tag，
# 搜尋一律以 _tag 過濾，確保只讀寫「本園」資料。
# ★ 強烈建議改成獨一無二的字串，避免與他人在公開伺服器上的資料混淆。
TENANT_TAG=morninglight-kg-demo

# 幣別與合作金庫銀行代碼
CURRENCY=TWD
BANK_CODE=006

# 勞健保「員工自付」有效費率（自動計算時，以投保薪資為基數）
# 預設：勞保自付 2.4%、健保自付 1.55%（簡化版，實務費率請依當年度調整）
LABOR_INS_RATE=0.024
HEALTH_INS_RATE=0.0155

# 會計室核銷端登入密碼（打卡端免密碼；簽核/薪資等管理功能需此密碼）
# ★ 正式使用請務必改成自己的密碼
ADMIN_PASSWORD=admin1234

# 忘記簽退 email 提醒
# 自動檢查間隔（小時）；0 = 關閉自動（仍可在出勤稽核手動寄送）
REMINDER_INTERVAL_HOURS=6
# 寄信 SMTP（未設定 SMTP_HOST 時走「乾跑」模式：只記錄不真的寄出）
# 例：Gmail 用 SMTP_HOST=smtp.gmail.com、SMTP_PORT=587、帳號 + 應用程式密碼
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=益民幼兒園 <no-reply@morninglight.kindergarten>
